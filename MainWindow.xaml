<Window x:Class="KeyboardMouseOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Keyboard Mouse Overlay"
        Height="330"
        Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="KEYSTROKE OVERLAY" FontSize="26" FontWeight="Bold" Foreground="#111827"/>
            <TextBlock x:Name="StatusText" Text="Status: Stopped" Margin="0,8,0,0" Foreground="#374151" FontSize="16"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="ToggleButton"
                    Width="140"
                    Height="38"
                    Content="Start Overlay"
                    Click="ToggleButton_Click"/>
            <Button Width="90"
                    Height="38"
                    Margin="12,0,0,0"
                    Content="Exit"
                    Click="ExitButton_Click"/>
        </StackPanel>

        <Border Grid.Row="2" BorderThickness="1" BorderBrush="#E5E7EB" CornerRadius="10" Padding="12" Background="#F9FAFB">
            <StackPanel>
                <TextBlock Text="Display" FontSize="14" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Text size" VerticalAlignment="Center" Foreground="#374151"/>
                    <Slider x:Name="TextSizeSlider" Grid.Column="1" Minimum="18" Maximum="42" Value="28" TickPlacement="BottomRight" IsSnapToTickEnabled="True" ValueChanged="TextSizeSlider_ValueChanged"/>
                </Grid>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Opacity" VerticalAlignment="Center" Foreground="#374151"/>
                    <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.4" Maximum="1" Value="0.9" TickPlacement="BottomRight" ValueChanged="OpacitySlider_ValueChanged"/>
                </Grid>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Display time" VerticalAlignment="Center" Foreground="#374151"/>
                    <Slider x:Name="DisplayDurationSlider" Grid.Column="1" Minimum="0.6" Maximum="3" Value="1.2" TickPlacement="BottomRight" ValueChanged="DisplayDurationSlider_ValueChanged"/>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" Text="Click the Start Overlay button to begin monitoring keyboard and mouse input." Foreground="#4B5563" TextWrapping="Wrap"/>
    </Grid>
</Window>
